# Optional: CORE API Key for academic paper search and discovery
# Get a free API key at https://core.ac.uk/services/api
# The core application (PDF extraction, summarization, concept graph) works
# completely offline without this key.
CORE_API_KEY=

# Optional: Application configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_THEME_PRIMARY_COLOR="#4f46e5"
